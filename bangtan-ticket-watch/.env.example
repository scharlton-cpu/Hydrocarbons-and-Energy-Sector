# Bangtan Ticket Watch — environment variables
#
# Copy this file to .env.local for local development. Nothing in this file
# is required to run the app: with no variables set, all three marketplace
# providers run in mock/demo mode and the app uses its in-memory demo data
# layer instead of Postgres. See README.md for details.

# --- Database (production) --------------------------------------------
# Postgres connection string for Prisma (prisma/schema.prisma). Not read
# by the app yet — the MVP ships on an in-memory demo data layer — but
# required once you run `npx prisma migrate dev` against real
# infrastructure (Supabase or any managed Postgres works).
DATABASE_URL=

# --- Marketplace provider credentials -----------------------------------
# Each provider adapter (src/lib/providers/*.ts) checks its own required
# env vars via isLive(). Leave unset to keep that provider in mock mode.

# SeatGeek Platform API — see src/lib/providers/seatgeek.ts
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# StubHub partner/affiliate API — see src/lib/providers/stubhub.ts
STUBHUB_CLIENT_ID=
STUBHUB_CLIENT_SECRET=

# TickPick partnership API — see src/lib/providers/tickpick.ts
TICKPICK_API_KEY=
